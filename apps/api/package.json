{
  "name": "@rpgforce-ai/api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "main": "./dist/main.js",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @rpgforce-ai/shared run build && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "ingest:srd": "pnpm --filter @rpgforce-ai/shared run build && nest build && node dist/ingest-srd.js",
    "ingest:srd:items": "pnpm run ingest:srd -- items",
    "ingest:srd:spells": "pnpm run ingest:srd -- spells",
    "ingest:srd:feats": "pnpm run ingest:srd -- feats",
    "ingest:srd:backgrounds": "pnpm run ingest:srd -- backgrounds",
    "ingest:srd:races": "pnpm run ingest:srd -- races",
    "ingest:srd:abilities": "pnpm run ingest:srd -- abilities",
    "ingest:srd:classes": "pnpm run ingest:srd -- classes",
    "ingest:srd:rulesets": "pnpm run ingest:srd -- rulesets",
    "ingest:srd:languages": "pnpm run ingest:srd -- languages",
    "ingest:srd:synthetic": "pnpm run ingest:srd -- synthetic",
    "user:role": "pnpm --filter @rpgforce-ai/shared run build && nest build && node dist/set-user-role.js",
    "embed:srd": "pnpm --filter @rpgforce-ai/shared run build && nest build && node dist/embed-srd.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "@rpgforce-ai/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "openai": "^6.45.0",
    "openid-client": "^6.8.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^25.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.6"
  }
}
