# ---- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://rpgforge:rpgforge_dev@localhost:5432/rpgforge_ai?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_EXPIRES_IN=900 # 15 min
JWT_REFRESH_EXPIRES_IN=604800 # 7 days
FRONTEND_URL="http://localhost:4000"
OPENAI_API_KEY="sk-..."
PORT=4001

# ---- Production only --------------------------------------------------------
# true ONLY behind a proxy (Render, nginx). Rate limiting then reads the caller's real IP from
# X-Forwarded-For; with no proxy in front, anyone could forge that header to dodge the limit.
TRUST_PROXY=false

# Never set by hand: the Docker image points this at /usr/bin/chromium, and locally puppeteer
# uses the browser it downloaded itself.
# PUPPETEER_EXECUTABLE_PATH=

# ---- Social sign-in (optional: empty turns the provider off) ----------------
# Register this callback in each console. It points at the WEB app, not here, because the web
# proxies /api/* to this API and that is what keeps the session cookie first-party:
#   http://localhost:4000/api/auth/oauth/<provider>/callback
# Google:  https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only when the browser reaches the web app on an origin other than FRONTEND_URL.
OAUTH_CALLBACK_BASE_URL=
