generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  characterSheets CharacterSheet[]
  generationRuns  GenerationRun[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum RuleItemKind {
  CLASS
  SUBCLASS
  CLASS_FEATURE
  SPELL
  FEAT
  BACKGROUND
  RACE
  ABILITY
  RULESET
  RULE
  ITEM
  OTHER
}

enum RuleRelationType {
  SUBCLASS_OF
  CLASS_HAS_FEATURE
  SUBCLASS_HAS_FEATURE
  SPELL_AVAILABLE_TO_CLASS
  RULESET_HAS_RULE
}

model Pack {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  version         String
  description     String?
  systemName      String
  externalKey     String?
  apiVersionHint  String?
  publisherName   String?
  permalink       String?
  licenseType     String
  licenseUrl      String?
  attributionText String   @db.Text
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ruleItems       RuleItem[]
  characterSheets CharacterSheet[]
  generationRuns  GenerationRun[]

  @@index([slug])
  @@index([systemName])
  @@map("packs")
}

model CharacterSheet {
  id            String   @id @default(uuid())
  userId        String
  packId        String
  name          String
  data          Json
  schemaVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Restrict)

  generationRun GenerationRun?

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("character_sheets")
}

/// The AI wizard interaction that produced a sheet: the concept, what the model asked, what the user
/// answered, and the justification it returned. Kept OUT of `CharacterSheet.data` on purpose: nothing
/// reads it on the sheet's hot path, and `findUnique` there has no `select`, so a column or a JSON key
/// would ship on every sheet load. Written only when the draft is actually saved.
model GenerationRun {
  id               String   @id @default(uuid())
  userId           String
  packId           String
  characterSheetId String   @unique
  /// The user's original concept text.
  prompt           String
  /// How the model interpreted the concept (Markdown, shown in the wizard's review step).
  note             String
  /// [{ id, question, options[], answer }] — the clarifying round, questions paired with the answers.
  questions        Json
  /// summary + per-area decisions + per-spell notes returned by the loadout call.
  meta             Json
  /// Model id that produced it, so a run stays interpretable after a model change.
  model            String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack           Pack           @relation(fields: [packId], references: [id], onDelete: Restrict)
  characterSheet CharacterSheet @relation(fields: [characterSheetId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("generation_runs")
}

model RuleItem {
  id            String                       @id @default(uuid())
  packId        String
  kind          RuleItemKind
  source        String                       @default("open5e")
  sourceKey     String
  sourceUrl     String?
  sourceVersion String?
  name          String
  slug          String?
  contentMd     String?                      @db.Text
  raw           Json
  normalized    Json?
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  pack     Pack               @relation(fields: [packId], references: [id], onDelete: Cascade)
  outgoing RuleItemRelation[] @relation("RuleItemFrom")
  incoming RuleItemRelation[] @relation("RuleItemTo")
  tags     RuleItemTag[]

  @@unique([packId, kind, sourceKey])
  @@index([packId, kind])
  @@index([name])
  @@map("rule_items")
}

model RuleItemRelation {
  id        String           @id @default(uuid())
  fromId    String
  toId      String
  type      RuleRelationType
  meta      Json?
  createdAt DateTime         @default(now())

  from RuleItem @relation("RuleItemFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   RuleItem @relation("RuleItemTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId, type])
  @@index([toId, type])
  @@map("rule_item_relations")
}

model Tag {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  items RuleItemTag[]

  @@map("tags")
}

model RuleItemTag {
  ruleItemId String
  tagId      String

  ruleItem RuleItem @relation(fields: [ruleItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleItemId, tagId])
  @@index([tagId])
  @@map("rule_item_tags")
}
